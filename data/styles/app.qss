/* Global application chrome. Semantic roles via objectName / dynamic properties.
   Avoid hardcoded black/white on text; use palette() where possible. */

/* ---- Toolbar action buttons ---- */
QPushButton#addButton,
QPushButton#replaceButton,
QPushButton#settingsButton,
QPushButton#idSettingsButton,
QPushButton#helpButton,
QPushButton#openFileButton,
QPushButton#identifyButton,
QPushButton#autoSynthButton,
QPushButton#runButton,
QPushButton#continueButton {
    background-color: #2e7d32;
    color: white;
    border: 2px solid #1b5e20;
    border-style: outset;
    border-radius: 5px;
    padding: 6px;
    min-width: 40px;
    min-height: 40px;
    font-size: 14pt;
}

QPushButton#addButton:hover,
QPushButton#replaceButton:hover,
QPushButton#settingsButton:hover,
QPushButton#idSettingsButton:hover,
QPushButton#helpButton:hover,
QPushButton#openFileButton:hover,
QPushButton#identifyButton:hover,
QPushButton#autoSynthButton:hover,
QPushButton#runButton:hover,
QPushButton#continueButton:hover {
    background-color: #388e3c;
    border-style: inset;
}

QPushButton#addButton:pressed,
QPushButton#replaceButton:pressed,
QPushButton#settingsButton:pressed,
QPushButton#idSettingsButton:pressed,
QPushButton#helpButton:pressed,
QPushButton#openFileButton:pressed,
QPushButton#identifyButton:pressed,
QPushButton#autoSynthButton:pressed,
QPushButton#runButton:pressed,
QPushButton#continueButton:pressed {
    background-color: #1b5e20;
    border-style: inset;
    padding: 3px;
}

/* Автосинтез — янтарный акцент */
QPushButton#autoSynthButton {
    background-color: #ef6c00;
    border-color: #e65100;
}
QPushButton#autoSynthButton:hover {
    background-color: #fb8c00;
}
QPushButton#autoSynthButton:pressed {
    background-color: #e65100;
}

QPushButton#idSettingsButton,
QPushButton#continueButton {
    background-color: #1565c0;
    border-color: #0d47a1;
}
QPushButton#idSettingsButton:hover,
QPushButton#continueButton:hover {
    background-color: #1e88e5;
}
QPushButton#idSettingsButton:pressed,
QPushButton#continueButton:pressed {
    background-color: #0d47a1;
}
QPushButton#continueButton:disabled {
    background-color: #9e9e9e;
    border-color: #757575;
}

QPushButton#clearButton {
    background-color: #c62828;
    color: white;
    border: 2px solid #8e0000;
    border-style: outset;
    border-radius: 5px;
    padding: 6px;
    min-width: 40px;
    min-height: 40px;
    font-size: 14pt;
}

QPushButton#clearButton:hover {
    background-color: #d32f2f;
    border-style: inset;
}

QPushButton#clearButton:pressed {
    background-color: #8e0000;
    border-style: inset;
    padding: 3px;
}

/* ---- Identification / RIM sidebar (text buttons, not 40×40 icons) ---- */
QFrame#idSidebar,
QFrame#idModelCard,
QFrame#rimSidebar,
QFrame#rimModelCard {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 8px;
}

QLabel#idCardTitle,
QLabel#rimCardTitle {
    font-size: 10.5pt;
    font-weight: 600;
    color: palette(window-text);
    padding-bottom: 2px;
}

QFrame#idSidebar QPushButton#openFileButton,
QFrame#idSidebar QPushButton#identifyButton,
QFrame#idSidebar QPushButton#clearButton,
QFrame#rimSidebar QPushButton#runButton,
QFrame#rimSidebar QPushButton#continueButton,
QFrame#rimSidebar QPushButton#clearButton {
    min-width: 0;
    min-height: 32px;
    font-size: 10.5pt;
    padding: 6px 12px;
}

QFrame#idSidebar QPushButton#openFileButton {
    min-height: 36px;
}

QFrame#idSidebar QPushButton#identifyButton,
QFrame#rimSidebar QPushButton#runButton {
    min-height: 36px;
    font-size: 11pt;
    font-weight: 600;
}

QFrame#idModelCard QPushButton#copyTfButton,
QFrame#idModelCard QPushButton#equationsButton {
    min-width: 132px;
    min-height: 32px;
    padding: 5px 14px;
    font-size: 10.5pt;
    color: white;
    border-style: outset;
    border-width: 2px;
    border-radius: 5px;
}

QFrame#idModelCard QPushButton#copyTfButton {
    background-color: #2e7d32;
    border-color: #1b5e20;
}
QFrame#idModelCard QPushButton#copyTfButton:hover {
    background-color: #388e3c;
    border-style: inset;
}
QFrame#idModelCard QPushButton#copyTfButton:pressed {
    background-color: #1b5e20;
    border-style: inset;
}
QFrame#idModelCard QPushButton#copyTfButton:disabled {
    background-color: #9e9e9e;
    border-color: #757575;
}

QFrame#idModelCard QPushButton#equationsButton {
    background-color: #6a1b9a;
    border-color: #4a148c;
}
QFrame#idModelCard QPushButton#equationsButton:hover {
    background-color: #8e24aa;
    border-style: inset;
}
QFrame#idModelCard QPushButton#equationsButton:pressed {
    background-color: #4a148c;
    border-style: inset;
}
QFrame#idModelCard QPushButton#equationsButton:disabled {
    background-color: #9e9e9e;
    border-color: #757575;
}

/* ---- Synthesis regulator card ---- */
QFrame#regulatorCard {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 8px;
}

QLabel#regulatorCardTitle {
    font-size: 11pt;
    font-weight: 600;
    color: palette(window-text);
    padding-bottom: 2px;
}

QLabel#paramTitle {
    font-size: 14pt;
    font-weight: 600;
}

QFrame#regulatorFace {
    background-color: palette(base);
    border: 1px solid palette(mid);
}

QLabel#faceLawLabel {
    font-size: 13pt;
    font-weight: 600;
}

QLabel#faceFormulaLabel,
QLabel#facePolyLabel {
    font-size: 12pt;
    padding: 2px 0 6px 0;
}

QToolButton#viewPlaneButton,
QToolButton#viewFaceButton {
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    padding: 0;
    margin: 0;
    border: 1px solid palette(mid);
    background: palette(base);
    font-family: "Font Awesome 6 Free Solid", "Font Awesome 6 Free";
    font-weight: 900;
    font-size: 9pt;
}
QToolButton#viewPlaneButton {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}
QToolButton#viewFaceButton {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    margin-left: -1px;
}
QToolButton#viewPlaneButton:checked,
QToolButton#viewFaceButton:checked {
    background: palette(highlight);
    color: palette(highlighted-text);
    font-weight: 600;
}

QLabel#faceC0Name,
QLabel#faceC1Name,
QLabel#faceC2Name {
    font-size: 12pt;
}

QLabel#faceC0Value,
QLabel#faceC1Value,
QLabel#faceC2Value {
    font-size: 12pt;
    font-family: "Consolas", "Cascadia Mono", "Courier New", monospace;
}

/* ---- Transfer function form (editable) + display (readonly) ---- */
TranFuncForm QLabel#tfTitle,
TfDisplayWidget QLabel#tfTitle {
    font-size: 24pt;
}

/* Fraction bar N / D — same role as text (dark on light, light/white on dark) */
TranFuncForm QFrame#tfDivider,
TfDisplayWidget QFrame#tfDivider {
    background-color: palette(window-text);
    border: none;
    min-height: 2px;
    max-height: 2px;
    margin: 2px 0;
}

/* Read-only poly text on identification tab */
TfDisplayWidget QLabel#tfPolyText {
    font-size: 14pt;
    color: palette(window-text);
    padding: 2px 6px;
}

TfDisplayWidget QLabel#tfDelayText {
    font-size: 16pt;
    color: palette(window-text);
    padding-left: 8px;
}

TranFuncForm QLineEdit#tfCoeff {
    font-size: 16pt;
    min-width: 36px;
}

/* Sign of coefficient — light accents (readable on dark themes) */
TranFuncForm QLineEdit#tfCoeff[coeffSign="zero"] {
    color: #ce93d8;
}

TranFuncForm QLineEdit#tfCoeff[coeffSign="positive"] {
    color: #80d8ff; /* light cyan / blue */
}

TranFuncForm QLineEdit#tfCoeff[coeffSign="negative"] {
    color: #ffb0c8; /* light pink */
}

TranFuncForm QLabel#tfPower {
    font-size: 16pt;
}

TranFuncForm QLabel#tfPower[powerActive="false"] {
    /* mid is a bevel fill and nearly invisible on dark themes */
    color: palette(placeholder-text);
}

/* Explanatory / secondary labels in dialogs — readable on light and dark */
QLabel#hintLabel,
QLabel#structHint,
QLabel#delayHint,
QLabel#approxHint,
QLabel#seriesHint {
    color: palette(placeholder-text);
}

TranFuncForm QLabel#tfPower[powerActive="true"] {
    color: palette(window-text);
}

/* Delay: · e^(− τ p) */
TranFuncForm QLabel#tfMulDot {
    font-size: 22pt;
    color: palette(window-text);
    padding: 0 4px;
}

TranFuncForm QLabel#tfDelayBase {
    font-size: 28pt;
    font-weight: 500;
    color: palette(window-text);
    padding-bottom: 2px;
}

TranFuncForm QLabel#tfDelayMinus,
TranFuncForm QLabel#tfDelayP {
    font-size: 14pt;
    color: palette(window-text);
}

TranFuncForm QDoubleSpinBox#tfDelay {
    font-size: 13pt;
    padding: 1px 3px;
    /* width is content-driven in code; do not force min-width */
}

TranFuncForm QWidget#tfDelayExp {
    padding-top: 0;
}

/* Charts visibility tool button */
QToolButton#chartsButton {
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    padding: 2px;
    font-size: 14pt;
    background-color: #6a1b9a;
    color: white;
    border: 2px solid #4a148c;
    border-style: outset;
    border-radius: 5px;
}
QToolButton#chartsButton:hover {
    background-color: #7b1fa2;
    border-style: inset;
}
QToolButton#chartsButton:pressed {
    background-color: #4a148c;
    border-style: inset;
}

/* Overlay clipboard buttons under delay / display copy */
TranFuncForm QPushButton#tfCopyButton,
TranFuncForm QPushButton#tfPasteButton,
TfDisplayWidget QPushButton#tfCopyButton {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    margin: 0;
    font-size: 9pt;
    color: white;
    border-style: outset;
    border-width: 1px;
    border-radius: 4px;
}

/* Copy — green (same family as + / add) */
TranFuncForm QPushButton#tfCopyButton,
TfDisplayWidget QPushButton#tfCopyButton {
    background-color: #2e7d32;
    border-color: #1b5e20;
}
TranFuncForm QPushButton#tfCopyButton:hover,
TfDisplayWidget QPushButton#tfCopyButton:hover {
    background-color: #388e3c;
    border-style: inset;
}
TranFuncForm QPushButton#tfCopyButton:pressed,
TfDisplayWidget QPushButton#tfCopyButton:pressed {
    background-color: #1b5e20;
    border-style: inset;
}

/* Paste — blue */
TranFuncForm QPushButton#tfPasteButton {
    background-color: #1565c0;
    border-color: #0d47a1;
}
TranFuncForm QPushButton#tfPasteButton:hover {
    background-color: #1e88e5;
    border-style: inset;
}
TranFuncForm QPushButton#tfPasteButton:pressed {
    background-color: #0d47a1;
    border-style: inset;
}

/* ---- Metrics panel (adaptive; room for HTML subscripts) ---- */
RegulationWidget QLabel#metricLabel {
    font-size: 10pt;
    padding: 2px 4px 4px 2px; /* bottom pad so <sub> is not clipped */
    min-width: 0;
    /* no max-width — width follows content / layout */
}

RegulationWidget QLineEdit#metricValue {
    font-size: 10pt;
    padding: 2px 6px;
    /* width fixed in code for significant/scientific digits */
    background-color: palette(base);
    color: palette(text);
    font-family: "Consolas", "Cascadia Mono", "Courier New", monospace;
}

/* Flash: 0 neutral, 1 “better/down role”, 2 “worse/up role” — soft fills work on light+dark */
RegulationWidget QLineEdit#metricValue[metricFlash="0"] {
    background-color: palette(base);
}

RegulationWidget QLineEdit#metricValue[metricFlash="1"] {
    background-color: rgba(46, 125, 50, 0.35);
}

RegulationWidget QLineEdit#metricValue[metricFlash="2"] {
    background-color: rgba(198, 40, 40, 0.35);
}

/* ---- Regulator parameter row: [✓] Kp  value  ──slider──  ⚙ ---- */
QLabel#regParamLabel {
    font-size: 14pt;
}

QDoubleSpinBox#regParamValue {
    font-size: 11pt;
    font-family: "Consolas", "Cascadia Mono", "Courier New", monospace;
    color: palette(window-text);
    padding: 1px 2px;
    min-width: 72px;
    max-width: 72px;
    min-height: 28px;
    max-height: 28px;
}

QCheckBox#regParamCheck {
    spacing: 0;
    padding: 0;
    margin: 0;
}

QPushButton#regParamSettings {
    background-color: palette(base);
    color: palette(window-text);
    border: 1px solid palette(mid);
    border-radius: 5px;
    padding: 0;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    font-size: 11pt;
}
QPushButton#regParamSettings:hover {
    background-color: palette(alternate-base);
    border-color: palette(dark);
}
QPushButton#regParamSettings:pressed {
    background-color: palette(midlight);
}

/* ---- Chart viewer window (detached graph) — palette-driven for light/dark ---- */
QMainWindow#ChartViewerWindow {
    background-color: palette(window);
}

QMainWindow#ChartViewerWindow QToolBar#chartViewerToolBar {
    background-color: palette(base);
    border: none;
    border-bottom: 1px solid palette(mid);
    spacing: 4px;
    padding: 6px 10px;
}

QMainWindow#ChartViewerWindow QToolBar#chartViewerToolBar QToolButton {
    background-color: transparent;
    color: palette(window-text);
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 10px;
    margin: 0 1px;
    font-size: 10.5pt;
}

QMainWindow#ChartViewerWindow QToolBar#chartViewerToolBar QToolButton:hover {
    background-color: palette(alternate-base);
    border-color: palette(mid);
}

QMainWindow#ChartViewerWindow QToolBar#chartViewerToolBar QToolButton:pressed {
    background-color: palette(midlight);
}

QMainWindow#ChartViewerWindow QToolBar#chartViewerToolBar QToolButton:checked {
    background-color: palette(highlight);
    border-color: palette(highlight);
    color: palette(highlighted-text);
    font-weight: 600;
}

QMainWindow#ChartViewerWindow QToolBar#chartViewerToolBar::separator {
    background-color: palette(mid);
    width: 1px;
    margin: 4px 8px;
}

QMainWindow#ChartViewerWindow QStatusBar#chartViewerStatusBar {
    background-color: palette(base);
    border-top: 1px solid palette(mid);
    color: palette(window-text);
    padding: 2px 8px;
    min-height: 26px;
}

QMainWindow#ChartViewerWindow QLabel#chartViewerCoordLabel {
    color: palette(window-text);
    font-family: "Consolas", "Cascadia Mono", "Courier New", monospace;
    font-size: 9.5pt;
    padding: 2px 4px;
}

QMainWindow#ChartViewerWindow QLabel#chartViewerHintsLabel {
    color: palette(placeholder-text);
    font-size: 9pt;
    padding: 2px 4px;
}

QMainWindow#ChartViewerWindow QChartView#chartViewerView {
    background-color: palette(base);
    border: none;
}

/* ---- Transfer-function inspector dialog ---- */
QDialog#TranFuncDialog {
    background-color: palette(window);
}

QDialog#TranFuncDialog QScrollArea#bodyScroll,
QDialog#TranFuncDialog QScrollArea#bodyScroll > QWidget,
QDialog#TranFuncDialog QWidget#bodyContents {
    background: transparent;
    border: none;
}

QDialog#TranFuncDialog QFrame#tfCard {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-top: 3px solid palette(mid);
    border-radius: 8px;
}

QDialog#TranFuncDialog QFrame#tfCard[tfRole="formula"] {
    background-color: rgba(38, 166, 154, 0.12);
    border-top: 3px solid #26a69a;
}

QDialog#TranFuncDialog QFrame#tfCard[tfRole="poles"] {
    background-color: rgba(126, 87, 194, 0.12);
    border-top: 3px solid #7e57c2;
}

QDialog#TranFuncDialog QFrame#tfCard[tfRole="solutions"] {
    background-color: rgba(66, 165, 245, 0.12);
    border-top: 3px solid #42a5f5;
}

QDialog#TranFuncDialog QFrame#tfCard[tfRole="de"] {
    background-color: rgba(144, 164, 174, 0.12);
    border-top: 3px solid #90a4ae;
}

QDialog#TranFuncDialog QLabel#tfCardTitle {
    font-size: 11pt;
    font-weight: 600;
    color: palette(window-text);
    padding: 2px 2px 4px 2px;
}

QDialog#TranFuncDialog QLabel#tfEqTitle {
    font-size: 10pt;
    font-weight: 600;
    color: palette(window-text);
}

QDialog#TranFuncDialog QToolButton#tfSectionToggle,
QDialog#TranFuncDialog QToolButton#tfSectionToggle:hover,
QDialog#TranFuncDialog QToolButton#tfSectionToggle:pressed,
QDialog#TranFuncDialog QToolButton#tfSectionToggle:checked,
QDialog#TranFuncDialog QToolButton#tfSectionToggle:checked:hover,
QDialog#TranFuncDialog QToolButton#tfSectionToggle:focus {
    font-size: 11pt;
    font-weight: 600;
    padding: 4px 2px;
    color: palette(window-text);
    background: transparent;
    border: none;
    outline: none;
}

QDialog#TranFuncDialog QToolButton#tfSectionToggle:hover {
    background: rgba(127, 127, 127, 0.12);
    border-radius: 4px;
}

QDialog#TranFuncDialog QToolButton#tfCopyButton {
    font-size: 9pt;
    padding: 4px 10px;
    color: palette(window-text);
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 5px;
}

QDialog#TranFuncDialog QToolButton#tfCopyButton:hover {
    background-color: palette(alternate-base);
}

QDialog#TranFuncDialog QToolButton#tfCopyButton:pressed {
    background-color: palette(midlight);
}

QDialog#TranFuncDialog QFrame#tfSectionLine {
    color: palette(mid);
    max-height: 1px;
    margin: 2px 0;
}

QDialog#TranFuncDialog QWidget#tfFormulaHost,
QDialog#TranFuncDialog QFrame#tfEqBlock {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 6px;
}

QDialog#TranFuncDialog FormulaView {
    font-size: 13pt;
    font-family: "Cambria Math", "Cambria", "Times New Roman", serif;
    background: transparent;
    color: palette(window-text);
}

QDialog#TranFuncDialog TfDisplayWidget QLabel#tfTitle {
    font-size: 16pt;
}

QDialog#TranFuncDialog TfDisplayWidget QLabel#tfPolyText {
    font-size: 13pt;
}

QDialog#TranFuncDialog TfDisplayWidget QLabel#tfDelayText {
    font-size: 14pt;
}

QDialog#TranFuncDialog QHeaderView {
    background-color: transparent;
}

QDialog#TranFuncDialog QTableWidget {
    background-color: palette(base);
    alternate-background-color: rgba(127, 127, 127, 0.10);
    color: palette(window-text);
    border: 1px solid palette(mid);
    border-radius: 6px;
    gridline-color: transparent;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QDialog#TranFuncDialog QTableWidget::item {
    padding: 5px 12px 5px 8px;
}

QDialog#TranFuncDialog QHeaderView::section {
    font-weight: 600;
    font-size: 9.5pt;
    padding: 8px 12px 8px 8px;
    border: none;
    border-bottom: 1px solid palette(mid);
    border-right: 1px solid palette(mid);
}

