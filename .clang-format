# База Google + локальные правки. Неуказанное берётся из Google.

BasedOnStyle: Google                  # база: Google C++ style
IndentWidth: 4                        # void f() {\n····int x;\n}
UseTab: Never                         # отступы пробелами, не \t
Standard: Latest                      # C++23+ (concepts, ranges, …)
MaxEmptyLinesToKeep: 1                # a;\n\nb;  — не больше одной пустой
ColumnLimit: 120                      # перенос, если строка > 120
FixNamespaceComments: false           # }   а не  }  // namespace foo

KeepEmptyLines:
  AtStartOfBlock: false                 # убрать пустую строку сразу после {
WrapNamespaceBodyWithEmptyLines: Never  # убрать пустую строку сразу после { для namespace
AccessModifierOffset: -4                # class A {\npublic:\n····int x;\n};

# === Includes ===
SortIncludes: CaseInsensitive         # <Vector> и <vector> — один порядок
IncludeBlocks: Regroup                # блоки + пустая строка между ними
IncludeCategories: # меньший Priority — выше в файле
  - Regex: '^"'                       # #include "a.h"
    Priority: 1
  - Regex: '^<'                       # #include <vector>
    Priority: 2
  - Regex: '.*'
    Priority: 3
# → "project.h"\n\n<cmath>\n<vector>

# === Braces (Custom: else/catch на новой строке, остальное Attach) ===
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false               # case 1: {\n
  AfterClass: false                   # class A {
  AfterControlStatement: false        # if (x) {
  AfterEnum: false                    # enum E {
  AfterFunction: false                # void f() {
  AfterNamespace: false               # namespace N {
  AfterObjCDeclaration: false
  AfterStruct: false                  # struct S {
  AfterUnion: false                   # union U {
  AfterExternBlock: false             # extern "C" {
  BeforeCatch: true                   # }\ncatch (...) {
  BeforeElse: true                    # }\nelse {
  BeforeLambdaBody: false             # []() {
  BeforeWhile: false                  # } while (1);
  IndentBraces: false                 # не ··{
  SplitEmptyFunction: false           # Foo() : x(0) {}
  SplitEmptyRecord: true              # class A\n{\n}
  SplitEmptyNamespace: true           # namespace N\n{\n}

# === Short constructs ===
AllowShortIfStatementsOnASingleLine: Never     # if (x)\n····return;
AllowShortLoopsOnASingleLine: false            # while (x)\n····f();
AllowShortFunctionsOnASingleLine: Inline       # class A { int f() { return 1; } };
AllowShortCaseLabelsOnASingleLine: false       # case 1:\n····x = 1;
AllowShortBlocksOnASingleLine: Never           # while (1) {\n}

# === Spaces & alignment ===
SpaceBeforeParens: ControlStatements  # if (x)  /  f(x)
SpaceAfterCStyleCast: false           # (int)x
SpacesInAngles: false                 # vector<int>
SpacesInParentheses: false            # f(a, b)
SpacesInSquareBrackets: false         # a[0]
SpaceBeforeAssignmentOperators: true  # a = b
AlignConsecutiveAssignments: true     # a···= 1;\nlong·= 2;  (только =, без +=)
AlignTrailingComments: true           # int a;·// c1\nint bb;·// c2
SpacesBeforeTrailingComments: 1       # int a; // c (один пробел перед //)
DerivePointerAlignment: false         # не угадывать по файлу
PointerAlignment: Left                # int* p;  (не int *p)
